#!/bin/bash
set -euo pipefail

SCRIPT_NAME="PRESSHOST"
source "/usr/local/bin/common-utils.sh"

WHIPTAIL_BACKTITLE="PressHost"

input_site_url() {
    local default_url="${1:-}"
    local url=""
    
    calc_dialog_size 10 70
    while true; do
        url=$(whiptail --title "Site URL" --backtitle "$WHIPTAIL_BACKTITLE" \
            --inputbox "Enter the site URL (e.g., https://example.com, http://localhost, http://1.1.1.1:80):" \
            $CALC_HEIGHT $CALC_WIDTH "$default_url" 3>&1 1>&2 2>&3) || return 1
        
        if [[ -z "$url" ]]; then
            show_whiptail_error "Site URL is required."
            continue
        fi
        
        if ! validate_url "$url"; then
            show_whiptail_error "Invalid URL format. Examples: https://example.com, http://localhost, http://1.1.1.1:80"
            continue
        fi
        
        echo "$url"
        return 0
    done
}

input_version_select() {
    local press_type="$1"
    local version=""
    
    calc_dialog_size 12 60
    local choice
    choice=$(whiptail --title "${press_type} Version" --backtitle "$WHIPTAIL_BACKTITLE" \
        --radiolist "Select version to install:" $CALC_HEIGHT $CALC_WIDTH 2 \
        "latest" "Latest stable version" ON \
        "specific" "Specific version number" OFF \
        3>&1 1>&2 2>&3) || return 1
    
    if [[ "$choice" == "specific" ]]; then
        calc_dialog_size 10 60
        
        while true; do
            version=$(whiptail --title "${press_type} Version" --backtitle "$WHIPTAIL_BACKTITLE" \
                --inputbox "Enter the ${press_type} version (e.g., 6.4.3):" \
                $CALC_HEIGHT $CALC_WIDTH "" 3>&1 1>&2 2>&3) || return 1
            
            if [[ -z "$version" ]]; then
                echo ""
                return 0
            fi
            
            if ! validate_version "$version"; then
                show_whiptail_error "Invalid version format. Please use format: X.Y or X.Y.Z"
                continue
            fi
            
            echo "$version"
            return 0
        done
    fi
    
    echo ""
    return 0
}

input_site_title() {
    local default_title="${1:-PressHost Site}"
    
    calc_dialog_size 10 60
    local title
    title=$(whiptail --title "Site Title" --backtitle "$WHIPTAIL_BACKTITLE" \
        --inputbox "Enter the site title:" \
        $CALC_HEIGHT $CALC_WIDTH "$default_title" 3>&1 1>&2 2>&3) || return 1
    
    [[ -z "$title" ]] && title="$default_title"
    echo "$title"
    return 0
}

input_admin_user() {
    local default_user="${1:-admin}"
    
    calc_dialog_size 10 60
    while true; do
        local username
        username=$(whiptail --title "Admin Username" --backtitle "$WHIPTAIL_BACKTITLE" \
            --inputbox "Enter the admin username (3-20 alphanumeric characters):" \
            $CALC_HEIGHT $CALC_WIDTH "$default_user" 3>&1 1>&2 2>&3) || return 1
        
        [[ -z "$username" ]] && username="$default_user"
        
        if ! validate_username "$username"; then
            show_whiptail_error "Invalid username. Use 3-20 alphanumeric characters or underscores."
            continue
        fi
        
        echo "$username"
        return 0
    done
}

input_admin_email() {
    local default_email="${1:-}"
    
    calc_dialog_size 10 60
    while true; do
        local email
        email=$(whiptail --title "Admin Email" --backtitle "$WHIPTAIL_BACKTITLE" \
            --inputbox "Enter the admin email address:" \
            $CALC_HEIGHT $CALC_WIDTH "$default_email" 3>&1 1>&2 2>&3) || return 1
        
        if [[ -z "$email" ]]; then
            show_whiptail_error "Admin email is required."
            continue
        fi
        
        if ! validate_email "$email"; then
            show_whiptail_error "Invalid email format. Please enter a valid email address."
            continue
        fi
        
        echo "$email"
        return 0
    done
}

input_admin_pass() {
    calc_dialog_size 12 60
    
    if whiptail --title "Admin Password" --backtitle "$WHIPTAIL_BACKTITLE" \
        --yesno "Would you like to auto-generate a password?\n\nSelect 'No' to enter your own password." \
        $CALC_HEIGHT $CALC_WIDTH 3>&1 1>&2 2>&3; then
        local generated_pass
        generated_pass=$(generate_password 16)

        show_whiptail_warning "A admin password was generated:\n\n${generated_pass}\n\nCopy it now. Press OK to continue." "Generated Password"

        echo "generated:$generated_pass"
        return 0
    fi
    
    local password=""
    local password_confirm=""
    
    calc_dialog_size 10 60
    while true; do
        password=$(whiptail --title "Admin Password" --backtitle "$WHIPTAIL_BACKTITLE" \
            --passwordbox "Enter the admin password:" \
            $CALC_HEIGHT $CALC_WIDTH 3>&1 1>&2 2>&3) || return 1
        
        if [[ -z "$password" ]]; then
            show_whiptail_error "Password cannot be empty."
            continue
        fi
        
        if [[ ${#password} -lt 8 ]]; then
            show_whiptail_error "Password must be at least 8 characters long."
            continue
        fi
        
        password_confirm=$(whiptail --title "Confirm Password" --backtitle "$WHIPTAIL_BACKTITLE" \
            --passwordbox "Confirm the admin password:" \
            $CALC_HEIGHT $CALC_WIDTH 3>&1 1>&2 2>&3) || return 1
        
        if [[ "$password" != "$password_confirm" ]]; then
            show_whiptail_error "Passwords do not match. Please try again."
            continue
        fi
        
        echo "typed:$password"
        return 0
    done
}

input_locale() {
    local default_locale="${1:-en_US}"
    local options=()

    while IFS=',' read -r code name; do
        [[ -z "$code" ]] && continue
        options+=("$code" "$name")
    done < <(get_all_locales)

    calc_dialog_size 20 50
    local list_height=$((CALC_HEIGHT - 8))
    [[ $list_height -lt 10 ]] && list_height=10

    local choice
    choice=$(whiptail --title "Site Locale" --backtitle "$WHIPTAIL_BACKTITLE" \
        --menu "Select the site locale:" \
        $CALC_HEIGHT $CALC_WIDTH $list_height \
        --default-item "$default_locale" \
        "${options[@]}" \
        3>&1 1>&2 2>&3) || return 1

    echo "$choice"
    return 0
}

input_skip_email() {
    calc_dialog_size 10 60
    
    if whiptail --title "Email Notification" --backtitle "$WHIPTAIL_BACKTITLE" \
        --yesno "Skip sending the installation email notification?\n\nRecommended: Yes (Skip)" \
        $CALC_HEIGHT $CALC_WIDTH 3>&1 1>&2 2>&3; then
        echo "true"
    else
        echo "false"
    fi
    return 0
}

show_main_menu() {
    calc_dialog_size 18 60
    
    if verify_press_installation; then
        local choice
        choice=$(whiptail --title "PressHost" --backtitle "$WHIPTAIL_BACKTITLE" \
            --menu "\n✓ ${PRESS_TYPE} ${PRESS_VERSION} is installed\n\nSelect an option:" \
            $CALC_HEIGHT $CALC_WIDTH 3 \
            "1" "View installation info" \
            "2" "Exit" \
            3>&1 1>&2 2>&3) || return 255

        echo "$choice"
    else
        local choice
        choice=$(whiptail --title "PressHost" --backtitle "$WHIPTAIL_BACKTITLE" \
            --menu "\n⚠ No WordPress/ClassicPress installation detected\n\nSelect an option:" \
            $CALC_HEIGHT $CALC_WIDTH 4 \
            "1" "Install WordPress" \
            "2" "Install ClassicPress" \
            "3" "Exit" \
            3>&1 1>&2 2>&3) || return 255
        
        echo "$choice"
    fi
}

show_installation_summary() {
    local press_type="$1"
    local site_url="$2"
    local version="$3"
    local site_title="$4"
    local admin_user="$5"
    local admin_email="$6"
    local admin_pass="$7"
    local locale="$8"
    local generated="${9:-}"
    
    local version_display="${version:-Latest}"
    local password_display=""
    
    if [[ -n "$generated" ]]; then
        password_display="\nAdmin Password: $admin_pass\n\n⚠ SAVE THIS PASSWORD - It will not be shown again!"
    else
        password_display="\nAdmin Password: ********"
    fi
    
    calc_dialog_size 22 70
    
    local summary="Installation Summary
═══════════════════════════════════════

Press Type: $press_type
Version: $version_display
Site URL: $site_url
Site Title: $site_title
Admin User: $admin_user
Admin Email: $admin_email${password_display}
Locale: $locale

═══════════════════════════════════════"

    whiptail --title "Confirm Installation" --backtitle "$WHIPTAIL_BACKTITLE" \
        --yesno "$summary\n\nProceed with installation?" \
        $CALC_HEIGHT $CALC_WIDTH 3>&1 1>&2 2>&3
}

show_installation_info() {
    if ! verify_press_installation; then
        show_whiptail_error "No WordPress/ClassicPress installation found."
        return 1
    fi
    
    local site_url site_title
    site_url=$(wp option get home --allow-root --path="$PRESS_WP_DIR" 2>/dev/null || echo "unknown")
    site_title=$(wp option get blogname --allow-root --path="$PRESS_WP_DIR" 2>/dev/null || echo "unknown")
    
    calc_dialog_size 18 70
    
    local info="Current Installation
═══════════════════════════════════════

✓ ${PRESS_TYPE} is installed

Type: $PRESS_TYPE
Version: $PRESS_VERSION
Site URL: $site_url
Site Title: $site_title

Directories:
  Installation: $PRESS_WP_DIR
  Uploads: $PRESS_UPLOADS_DIR
  Cache: $PRESS_CACHE_DIR

═══════════════════════════════════════"

    whiptail --title "Installation Info" --backtitle "$WHIPTAIL_BACKTITLE" \
        --msgbox "$info" $CALC_HEIGHT $CALC_WIDTH
}

find_extracted_dir() {
    local temp_dir="$1"
    local extracted_dir

    extracted_dir=$(find "$temp_dir" -maxdepth 1 -type d \( -name 'classicpress*' -o -name 'ClassicPress*' -o -name 'wordpress' \) 2>/dev/null | head -1)

    if [[ -z "$extracted_dir" ]] || [[ "$extracted_dir" == "$temp_dir" ]]; then
        extracted_dir=$(find "$temp_dir" -maxdepth 1 -type d ! -name "$(basename "$temp_dir")" 2>/dev/null | head -1)
    fi

    if [[ -n "$extracted_dir" ]] && [[ "$extracted_dir" != "$temp_dir" ]] && [[ -d "$extracted_dir" ]]; then
        echo "$extracted_dir"
        return 0
    fi

    return 1
}

make_temp_dir() {
    mktemp -d "/tmp/$1.XXXXXX"
}

get_press_download_url() {
    local type="$1" # wordpress|classicpress

    case "$type" in
        wordpress)
            if [[ -n "${INSTALL_WORDPRESS_VERSION:-}" ]]; then
                echo "https://wordpress.org/wordpress-${INSTALL_WORDPRESS_VERSION}.zip"
            else
                echo "https://wordpress.org/latest.zip"
            fi
            ;;
        classicpress)
            if [[ -n "${INSTALL_CLASSICPRESS_VERSION:-}" ]]; then
                echo "https://github.com/ClassicPress/ClassicPress-release/archive/refs/tags/${INSTALL_CLASSICPRESS_VERSION}.zip"
            else
                echo "https://www.classicpress.net/latest.zip"
            fi
            ;;
        *)
            return 1
            ;;
    esac
}

get_press_version_info() {
    local type="$1" # wordpress|classicpress

    case "$type" in
        wordpress)
            if [[ -n "${INSTALL_WORDPRESS_VERSION:-}" ]]; then
                echo "WordPress ${INSTALL_WORDPRESS_VERSION}"
            else
                echo "WordPress (latest)"
            fi
            ;;
        classicpress)
            if [[ -n "${INSTALL_CLASSICPRESS_VERSION:-}" ]]; then
                echo "ClassicPress ${INSTALL_CLASSICPRESS_VERSION}"
            else
                echo "ClassicPress (latest)"
            fi
            ;;
        *)
            return 1
            ;;
    esac
}

install_press() {
    local type="$1" # wordpress|classicpress
    local press_name=""
    local temp_dir=""
    local download_url=""
    local version_info=""
    local archive_file=""
    local source_dir=""

    case "$type" in
        wordpress) press_name="WordPress" ;;
        classicpress) press_name="ClassicPress" ;;
        *)
            error "Unknown press type: $type"
            return 2
            ;;
    esac

    download_url=$(get_press_download_url "$type") || return 2
    version_info=$(get_press_version_info "$type") || return 2

    update_whiptail_progress 5 "Preparing installation environment..."

    temp_dir=$(make_temp_dir "$type")
    archive_file="$temp_dir/${type}.zip"

    trap 'cleanup_temp_dir "$temp_dir" >/dev/null 2>&1 || true' RETURN

    update_whiptail_progress 10 "Downloading ${version_info}..."
    local checksum_url=""
    if [[ "$type" == "wordpress" ]]; then
        checksum_url="${download_url}.sha1"
    fi
    if ! download_press_archive "$download_url" "$archive_file" "$press_name" "$checksum_url"; then
        error "Failed to download ${press_name}"
        return 1
    fi

    update_whiptail_progress 30 "Extracting ${press_name} files..."
    if ! extract_press_archive "$archive_file" "$temp_dir" "$press_name"; then
        error "Failed to extract ${press_name} archive"
        return 1
    fi

    if [[ "$type" == "classicpress" ]]; then
        update_whiptail_progress 40 "Organizing extracted files..."
        local extracted_dir
        if ! extracted_dir=$(find_extracted_dir "$temp_dir"); then
            error "Could not find extracted ClassicPress directory"
            return 1
        fi

        if [[ "$extracted_dir" != "$temp_dir/classicpress" ]]; then
            mv "$extracted_dir" "$temp_dir/classicpress"
        fi
        source_dir="$temp_dir/classicpress"
    else
        source_dir="$temp_dir/wordpress"
    fi

    update_whiptail_progress 50 "Installing ${press_name} files..."
    if ! install_press_files "$source_dir" "$press_name"; then
        error "Failed to install ${press_name} files"
        return 1
    fi

    update_whiptail_progress 55 "Setting up wp-content structure..."
    setup_press_content

    if ! verify_press_installation; then
        error "${press_name} installation failed verification (missing core files)"
        return 1
    fi

    update_whiptail_progress 60 "Configuring wp-config.php..."
    if ! create_press_config "$press_name"; then
        warning "wp-config.php creation skipped or failed"
    fi

    update_whiptail_progress 70 "Generating security keys..."
    if ! generate_press_secrets "$press_name"; then
        warning "Security keys generation skipped"
    fi

    update_whiptail_progress 80 "Running WP-CLI installation..."
    local wp_installed="false"
    if run_press_install "$press_name"; then
        wp_installed="true"
    else
        warning "WP-CLI installation step completed with warnings"
    fi

    update_whiptail_progress 90 "Setting final permissions..."
    set_press_permissions

    update_whiptail_progress 100 "${press_name} installation complete!"

    [[ "$wp_installed" == "true" ]]
}

get_installation_params() {
    local press_type="$1"
    
    GENERATED_PASSWORD=""
    
    # Step 1: Site URL
    local default_url="${INSTALL_URL:-${WP_HOME:-${WP_SITEURL:-}}}"
    INSTALL_URL=$(input_site_url "$default_url") || return 1
    
    # Step 2: Version
    local version
    version=$(input_version_select "$press_type") || return 1
    
    # Step 3: Site Title
    INSTALL_TITLE=$(input_site_title "${INSTALL_TITLE:-PressHost Site}") || return 1
    
    # Step 4: Admin Username
    INSTALL_USER=$(input_admin_user "${INSTALL_USER:-admin}") || return 1
    
    # Step 5: Admin Email
    INSTALL_EMAIL=$(input_admin_email "${INSTALL_EMAIL:-}") || return 1
    
    # Step 6: Admin Password
    local pass_result
    pass_result=$(input_admin_pass) || return 1
    INSTALL_PASS="${pass_result#*:}"
    if [[ "$pass_result" == generated:* ]]; then
        GENERATED_PASSWORD="$INSTALL_PASS"
    fi
    
    # Step 7: Locale
    INSTALL_LOCALE=$(input_locale "${INSTALL_LOCALE:-en_US}") || return 1
    
    # Step 8: Skip Email
    INSTALL_SKIP_EMAIL=$(input_skip_email) || return 1
    
    # Set version export
    if [[ -n "$version" ]]; then
        if [[ "$press_type" == "WordPress" ]]; then
            export INSTALL_WORDPRESS_VERSION="$version"
        else
            export INSTALL_CLASSICPRESS_VERSION="$version"
        fi
    fi
    
    # Step 9: Show Summary
    if ! show_installation_summary "$press_type" "$INSTALL_URL" "$version" \
        "$INSTALL_TITLE" "$INSTALL_USER" "$INSTALL_EMAIL" "$INSTALL_PASS" \
        "$INSTALL_LOCALE" "$GENERATED_PASSWORD"; then
        return 1
    fi
    
    export INSTALL_URL
    export INSTALL_TITLE
    export INSTALL_USER
    export INSTALL_PASS
    export INSTALL_EMAIL
    export INSTALL_SKIP_EMAIL
    export INSTALL_LOCALE
    
    return 0
}

run_installation_with_progress() {
    local press_type="$1"
    local install_target="$2" # wordpress|classicpress
    
    local PROGRESS_PIPE="/tmp/presshost_progress_$$_${RANDOM}"
    mkfifo "$PROGRESS_PIPE"
    
    calc_dialog_size 8 60
    whiptail --title "Installing ${press_type}" --backtitle "$WHIPTAIL_BACKTITLE" \
        --gauge "Starting installation..." $CALC_HEIGHT $CALC_WIDTH 0 < "$PROGRESS_PIPE" &
    local GAUGE_PID=$!

    export PRESSHOST_GAUGE_PID=$GAUGE_PID
    export PRESSHOST_PROGRESS_PIPE="$PROGRESS_PIPE"

    exec 3>"$PROGRESS_PIPE"
    export PRESSHOST_PROGRESS_FD=3
    
    local install_success=false

    local log_dir="${PRESS_LOGS_DIR:-/tmp}"
    mkdir -p "$log_dir" 2>/dev/null || log_dir="/tmp"
    local log_file="$log_dir/presshost-install-$(date +%Y%m%d-%H%M%S).log"

    if install_press "$install_target" >"$log_file" 2>&1; then
        install_success=true
    fi
    
    {
        printf 'XXX\n'
        printf '100\n'
        printf 'Finalizing...\n'
        printf 'XXX\n'
    } >&3 2>/dev/null || true

    exec 3>&-
    unset PRESSHOST_PROGRESS_FD
    unset PRESSHOST_GAUGE_PID

    wait $GAUGE_PID 2>/dev/null || true
    rm -f "$PROGRESS_PIPE"
    unset PRESSHOST_PROGRESS_PIPE

    if [[ "$install_success" == "true" ]]; then
        return 0
    fi

    show_whiptail_error "${press_type} installation failed.\n\nA detailed log will be shown next." "Installation Failed"
    show_whiptail_textbox "$log_file" "Installation Log" "$WHIPTAIL_BACKTITLE"
    return 1
}

install_press_ui() {
    local press_name="$1"   # "WordPress" or "ClassicPress"
    local press_target="$2" # "wordpress" or "classicpress"

    if verify_press_installation; then
        show_whiptail_error "${PRESS_TYPE} is already installed.\nInstallation cancelled."
        return 1
    fi

    if ! get_installation_params "$press_name"; then
        show_whiptail_info "Installation cancelled."
        return 1
    fi

    if run_installation_with_progress "$press_name" "$press_target"; then
        local success_msg="${press_name} installation completed successfully!\n\nURL: $INSTALL_URL\nAdmin: ${INSTALL_URL%/}/wp-admin/\nUsername: $INSTALL_USER"
        if [[ -n "$GENERATED_PASSWORD" ]]; then
            success_msg="$success_msg\nPassword: $GENERATED_PASSWORD\n\n⚠ SAVE THIS PASSWORD NOW!"
        fi
        show_whiptail_success "$success_msg" "Installation Complete"
        return 0
    else
        show_whiptail_error "${press_name} installation failed." "Installation Failed"
        return 1
    fi
}

main_menu() {
    if ! verify_press_installation; then
        case "${PRESSHOST_DEFAULT_ACTION:-}" in
            wordpress)
                unset PRESSHOST_DEFAULT_ACTION
                install_press_ui "WordPress" "wordpress"
                return $?
                ;;
            classicpress)
                unset PRESSHOST_DEFAULT_ACTION
                install_press_ui "ClassicPress" "classicpress"
                return $?
                ;;
        esac
    fi

    while true; do
        local choice
        choice=$(show_main_menu)
        local exit_code=$?

        if [[ $exit_code -eq 255 ]] || [[ $exit_code -eq 1 ]]; then
            break
        fi

        if verify_press_installation; then
            case "$choice" in
                1) show_installation_info ;;
                2) break ;;
                *) ;;
            esac
        else
            case "$choice" in
                1) install_press_ui "WordPress" "wordpress" ;;
                2) install_press_ui "ClassicPress" "classicpress" ;;
                3) break ;;
                *) ;;
            esac
        fi
    done

    clear
    echo "Thank you for using PressHost!"
}

fix_perms() {
    local target_user="${APP_USER:-www-data}"
    local target_group="${APP_GROUP:-www-data}"

    info "Repairing ownership and permissions on PressHost volumes"
    info "Target: ${target_user}:${target_group}"

    if [[ "$(id -u)" != "0" ]]; then
        error "fix-perms must be executed as root"
        error "Re-run with: docker exec <container> presshost fix-perms"
        return 1
    fi

    local paths=(
        "${APP_PATH:-/site/press}"
        "${UPLOADS_PATH:-/site/uploads}"
        "${CACHE_PATH:-/site/cache}"
        "${LOGS_PATH:-/site/logs}"
    )

    local rc=0
    for p in "${paths[@]}"; do
        if [[ ! -d "$p" ]]; then
            info "Skipping ${p} (not a directory)"
            continue
        fi
        info "Processing ${p}..."
        if ! safe-chown "$p"; then
            error "chown failed on ${p}"
            rc=1
        fi
        find "$p" -type d -exec chmod 755 {} + 2>/dev/null || true
        find "$p" -type f -exec chmod 644 {} + 2>/dev/null || true
    done

    # Sensitive files: tighter perms.
    local press_dir="${APP_PATH:-/site/press}"
    for sensitive in "${press_dir}/wp-config.php" "${press_dir}/wp-secrets.php"; do
        if [[ -f "$sensitive" ]]; then
            chmod 640 "$sensitive" 2>/dev/null || true
            info "Locked down ${sensitive} (640)"
        fi
    done

    local logs_dir="${LOGS_PATH:-/site/logs}"
    if [[ -d "$logs_dir" ]]; then
        chmod 750 "$logs_dir" 2>/dev/null || true
        find "$logs_dir" -type f -exec chmod 640 {} + 2>/dev/null || true
        info "Locked down ${logs_dir} (dir 750, files 640)"
    fi

    if [[ $rc -eq 0 ]]; then
        success "Permission fix complete"
    else
        error "Permission fix completed with errors"
    fi
    return $rc
}

main() {
    if [[ $# -gt 0 ]]; then
        case "$1" in
            -h|--help|help)
                cat <<'EOF'
Usage: presshost              Run interactive installer/menu
       presshost fix-perms    Reset owner+permissions on /site/{press,uploads,cache,logs}
       presshost help         Show this message
EOF
                exit 0
                ;;
            fix-perms)
                fix_perms
                exit $?
                ;;
        esac
    fi
    main_menu
}

main "$@"
