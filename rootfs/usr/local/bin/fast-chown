#!/bin/bash
set -e

APP_USER="${APP_USER:-www-data}"
APP_GROUP="${APP_GROUP:-www-data}"

[ $# -eq 0 ] && { echo "Usage: fast-chown <path>..." >&2; exit 1; }

for path in "$@"; do
    [ -e "$path" ] || continue
    find "$path" \( ! -user "$TARGET_USER" -o ! -group "$APP_GROUP" \) \
        -exec chown "${APP_USER}:${APP_GROUP}" {} + 2>/dev/null || true
done