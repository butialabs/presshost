#!/bin/bash
set -euo pipefail

if ! pgrep -x "nginx" > /dev/null; then
    echo "[ERROR] $(date -Iseconds) - nginx is not running"
    exit 1
fi

if ! curl -sk --fail --connect-timeout 2 --max-time 3 "https://localhost:${NGINX_HTTPS_PORT:-443}/nginx-status" > /dev/null \
    && ! curl -s --fail --connect-timeout 2 --max-time 3 "http://localhost:${NGINX_HTTP_PORT:-80}/nginx-status" > /dev/null; then
    echo "[ERROR] $(date -Iseconds) - nginx is not responding"
    exit 1
fi

echo "[INFO] $(date -Iseconds) - nginx is healthy"
