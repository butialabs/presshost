#!/bin/bash
set -uo pipefail

# Composite healthcheck used by HEALTHCHECK in Dockerfile.
# Validates that NGINX answers AND PHP-FPM ping responds.
# Valkey is only checked when VALKEY_ENABLED=true.

check() {
    local name="$1" out
    if ! out=$("/etc/s6-overlay/scripts/healthcheck-${name}" 2>&1); then
        echo "[ERROR] ${name} unhealthy" >&2
        [[ -n "$out" ]] && echo "$out" >&2
        return 1
    fi
    return 0
}

check nginx   || exit 1
check php-fpm || exit 1
check valkey  || exit 1

exit 0
