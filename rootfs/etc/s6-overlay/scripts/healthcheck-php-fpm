#!/bin/bash
set -euo pipefail

FPM_SOCK="/run/php/php${PHP_VERSION:-8.4}-fpm.sock"

if ! pgrep -f "php-fpm: master" > /dev/null; then
    echo "[ERROR] $(date -Iseconds) - PHP-FPM is not running"
    exit 1
fi

if [ ! -S "$FPM_SOCK" ]; then
    echo "[ERROR] $(date -Iseconds) - PHP-FPM socket does not exist"
    exit 1
fi

out=$(SCRIPT_NAME=/fpm-ping SCRIPT_FILENAME= REQUEST_METHOD=GET QUERY_STRING= \
    cgi-fcgi -bind -connect "$FPM_SOCK" 2>&1 || true)
if ! printf '%s' "$out" | grep -q "pong"; then
    echo "[ERROR] $(date -Iseconds) - PHP-FPM is not responding (ping output: $out)"
    exit 1
fi

echo "[INFO] $(date -Iseconds) - PHP-FPM is healthy"
